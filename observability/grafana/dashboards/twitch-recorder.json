{
  "uid": "twitch-recorder",
  "title": "Twitch Stream Recorder",
  "tags": ["twitch", "opentelemetry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "streamer",
        "label": "Streamer",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(twitch_recorder_active_recordings, twitch_streamer_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active recordings",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(twitch_recorder_active_recordings{twitch_streamer_name=~\"$streamer\"})",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current stream uptime",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (twitch_streamer_name) (twitch_recorder_stream_uptime_seconds{twitch_streamer_name=~\"$streamer\"})",
          "legendFormat": "{{twitch_streamer_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors (5m rate)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(twitch_recorder_errors_total[5m]))",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bytes written (total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(twitch_recorder_bytes_written_bytes_total{twitch_streamer_name=~\"$streamer\"})",
          "legendFormat": "bytes"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Write throughput",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (twitch_streamer_name) (rate(twitch_recorder_bytes_written_bytes_total{twitch_streamer_name=~\"$streamer\"}[5m]))",
          "legendFormat": "{{twitch_streamer_name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Recording duration percentiles",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(twitch_recorder_recording_duration_seconds_bucket[30m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(twitch_recorder_recording_duration_seconds_bucket[30m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Twitch API requests by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code, twitch_api_endpoint) (rate(twitch_recorder_api_requests_total[5m]))",
          "legendFormat": "{{twitch_api_endpoint}} {{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Errors by type",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_type) (rate(twitch_recorder_errors_total[5m]))",
          "legendFormat": "{{error_type}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Wide events",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 21 },
      "options": { "showTime": true, "wrapLogMessage": true },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"twitch-stream-recorder\"} | json | event_domain=\"twitch.recorder\""
        }
      ]
    }
  ]
}
