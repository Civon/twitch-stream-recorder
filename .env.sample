# Name of the streamer you want to record by default
username=

# You can grab this from here once you register your application
# https://dev.twitch.tv/console/apps
client_id=
client_secret=
# (Optional)Find insctruction in README
twitch_oauth_token=

# Folder MUST be an absolute path
archive=

# OpenTelemetry (optional). Telemetry stays off while the endpoint is empty;
# docker-compose.otel.yml overrides these to point at the local collector.
OTEL_SERVICE_NAME=twitch-stream-recorder
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
OTEL_METRIC_EXPORT_INTERVAL=15000
# Set to false to keep traces/metrics but stop exporting logs over OTLP
OTEL_LOGS_ENABLED=true
# Free-space share below which a disk_space_warning wide event is emitted
DISK_FREE_WARNING_RATIO=0.10
